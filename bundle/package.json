{
  "name": "dsh-social-plugin",
  "version": "0.0.1",
  "description": "DeepSeek Harness 社交插件：AI 代笔、默认匿名、逐条过审的观点交换网络",
  "type": "module",
  "exports": {
    ".": "./dist/web.js",
    "./client": "./dist/client.js",
    "./cloud": "./dist/cloud.js",
    "./commands": "./dist/commands.js",
    "./curator": "./dist/curator.js",
    "./local": "./dist/local.js",
    "./package.json": "./package.json",
    "./web": "./dist/web.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "social",
    "anonymous",
    "privacy"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
