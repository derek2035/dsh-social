{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 含 DOM 是因为 packages/web/src/client 是真的浏览器代码。
    // 代价：宿主侧代码误用 window/document 也能过类型检查。
    // 真出问题的话应该拆成两个 tsconfig，现在还不值得。
    "lib": ["ES2022", "DOM"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",

    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "baseUrl": ".",
    "paths": {
      "@dsh-social/core": ["packages/core/src/index.ts"],
      "@dsh-social/local": ["packages/local/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "test/**/*.ts"]
}
